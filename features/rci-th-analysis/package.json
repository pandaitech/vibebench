{
  "name": "rci-th-analysis",
  "version": "1.0.0",
  "private": true,
  "description": "Asas analitik untuk Laporan Suruhanjaya Siasatan Diraja Tabung Haji (2014-2020). Data mentah dinormalisasi, metadata sumber, data terbitan, definisi metrik, kandungan UI Bahasa Melayu, dan blueprint pelaksanaan dashboard EDA.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./json": "./dist/rci-th-analysis.json",
    "./src/*": "./src/*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "dist/",
    "README.md",
    "BLUEPRINT.md"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build:json": "node scripts/export-json.mjs",
    "check": "node scripts/validate.mjs && node scripts/export-json.mjs"
  },
  "sideEffects": false,
  "license": "UNLICENSED"
}
